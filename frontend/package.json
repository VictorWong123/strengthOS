{
  "name": "strengthos-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "validate:ios": "node scripts/validate-native-env.mjs",
    "ios:sync": "npm run validate:ios && npm run build && cap sync ios",
    "ios:sync:ci": "node scripts/validate-native-env.mjs --ci-fixture && npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test:native": "node tests/native.test.mjs",
    "test:return-to": "node tests/returnTo.test.mjs",
    "test:training": "node tests/trainingMetrics.test.mjs",
    "test:browser": "node tests/browser/run.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@supabase/supabase-js": "^2.58.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "vite": "^7.3.6"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
